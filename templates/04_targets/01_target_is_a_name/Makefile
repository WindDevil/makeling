# makeling exercise: 04_targets/01_target_is_a_name
# title: A target is just a name
# objective: Give the first rule the target name notes and the second the name real_file, so that make notes prints the note while real_file creates a file.
# reference: Targets
# hint: A rule's name is the target it defines: make asks for that exact name. A target with no file behind it is rebuilt every time.

note:
	echo "a target is only a name"

real_file:
	touch real_file
