#!/usr/bin/env python3
"""makefiling: a small, dependency-free runner for the makefiling exercises.

The runner uses only the Python standard library.  Each exercise is a directory
holding a ``Makefile`` and a ``checks.json`` contract.  To run one, the runner
copies the directory into ``build/makefiling/`` and replays the contract's steps
there, comparing what ``make`` printed, what it exited with, and which files it
left behind.

Exercises are staged rather than run in place so that ``make`` never litters
``exercises/`` with object files, and so that a multi-step contract (build,
then rebuild and observe that nothing happens) sees a clean slate every time.
"""

from __future__ import annotations

import argparse
import difflib
import fcntl
import json
import os
import platform
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent
EXERCISES_DIR = ROOT / "exercises"
SOLUTIONS_DIR = ROOT / "solutions"
TEMPLATES_DIR = ROOT / "templates"
BUILD_DIR = ROOT / "build" / "makefiling"
PROGRESS_FILE = ROOT / ".makefiling" / "progress.json"

STEP_TIMEOUT = 30.0

# 2000-01-01T00:00:00Z.  Staged files are dated from here, one second apart
# (see age_staged_files), so that everything a contract builds is strictly
# newer without depending on the clock or on the filesystem's timestamp
# granularity.  Far enough in the past to stay unambiguous, close enough that
# make's "modification time in the future" warning can never apply.
STAGE_EPOCH = 946684800

# The output of every step is compared in a C locale, so that make's own
# messages are the ones the checks were written against.
BASE_ENV = {
    "LC_ALL": "C",
    "LANG": "C",
    "LANGUAGE": "C",
    "MAKEFLAGS": "",
    "MFLAGS": "",
    "MAKELEVEL": "",
    "MAKE_TERMOUT": "",
    "MAKE_TERMERR": "",
}


# --------------------------------------------------------------------------
# Model
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Step:
    args: list[str]
    description: str = ""
    exit_code: int = 0
    stdout: str | None = None
    stdout_mode: str = "contains_lines"
    stderr: str | None = None
    stderr_mode: str = "contains"
    env: dict[str, str] = field(default_factory=dict)
    files: dict[str, str] = field(default_factory=dict)
    missing: list[str] = field(default_factory=list)


@dataclass(frozen=True)
class Exercise:
    topic: str
    slug: str
    path: Path
    title: str
    objective: str
    reference: str
    hint: str
    steps: list[Step]
    lesson: dict = field(default_factory=dict)

    @property
    def ident(self) -> str:
        return f"{self.topic}/{self.slug}"

    @property
    def solution_root(self) -> Path:
        return SOLUTIONS_DIR / self.topic / self.slug

    @property
    def template_root(self) -> Path:
        return TEMPLATES_DIR / self.topic / self.slug

    def fingerprint(self) -> tuple:
        """Detect edits, additions and deletions, including older auxiliary files."""
        files = []
        for path in self.path.rglob("*"):
            try:
                if path.is_file():
                    stat = path.stat()
                    files.append((str(path.relative_to(self.path)), stat.st_mtime_ns, stat.st_size))
            except FileNotFoundError:
                continue  # Editors may replace files atomically during a scan.
        return tuple(sorted(files))


# --------------------------------------------------------------------------
# Presentation helpers
# --------------------------------------------------------------------------


def color(text: str, code: str) -> str:
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{code}m{text}\033[0m"


def green(text: str) -> str:
    return color(text, "32")


def red(text: str) -> str:
    return color(text, "31")


def yellow(text: str) -> str:
    return color(text, "33")


def cyan(text: str) -> str:
    return color(text, "36")


def dim(text: str) -> str:
    return color(text, "2")


# --------------------------------------------------------------------------
# Discovery
# --------------------------------------------------------------------------


def load_exercise(directory: Path) -> Exercise | None:
    document = directory / "checks.json"
    if not document.is_file():
        return None
    try:
        data = json.loads(document.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        print(red(f"{directory}: unreadable checks.json ({error})"))
        return None

    steps = [Step(**entry) for entry in data.get("steps", [])]
    return Exercise(
        topic=directory.parent.name,
        slug=directory.name,
        path=directory,
        title=data.get("title", directory.name.replace("_", " ")),
        objective=data.get("objective", ""),
        reference=data.get("reference", ""),
        hint=data.get("hint", "No hint available."),
        steps=steps,
        lesson=data.get("lesson", {}),
    )


def discover(root: Path | None = None) -> list[Exercise]:
    root = EXERCISES_DIR if root is None else root
    exercises: list[Exercise] = []
    if not root.is_dir():
        return exercises
    for directory in sorted(path for path in root.glob("*/*") if path.is_dir()):
        exercise = load_exercise(directory)
        if exercise is not None:
            exercises.append(exercise)
    exercises.sort(key=lambda exercise: (exercise.topic, exercise.slug))
    return exercises


def load_progress() -> set[str]:
    if not PROGRESS_FILE.is_file():
        return set()
    try:
        data = json.loads(PROGRESS_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return set()
    return set(data.get("completed", []))


def save_progress(completed: set[str]) -> None:
    PROGRESS_FILE.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                     dir=PROGRESS_FILE.parent, delete=False) as output:
        temporary = Path(output.name)
        try:
            output.write(json.dumps({"completed": sorted(completed)}, indent=2) + "\n")
            output.close()
            temporary.replace(PROGRESS_FILE)
        finally:
            temporary.unlink(missing_ok=True)


def record_result(exercise: Exercise, passed: bool) -> None:
    """Serialize read/modify/write so concurrent runs cannot lose progress."""
    PROGRESS_FILE.parent.mkdir(parents=True, exist_ok=True)
    with (PROGRESS_FILE.parent / "progress.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        completed = load_progress()
        if passed:
            completed.add(exercise.ident)
        else:
            completed.discard(exercise.ident)
        save_progress(completed)


def filter_exercises(exercises: list[Exercise], topic: str | None = None,
                     basic: bool = False) -> list[Exercise]:
    if basic:
        exercises = sorted((e for e in exercises if e.lesson),
                           key=lambda e: e.lesson["order"])
    if topic:
        exercises = [e for e in exercises if e.topic.startswith(topic)]
    if not exercises:
        print(red(f"no exercises found for topic: {topic}" if topic else "no exercises found"))
    return exercises


def select(exercises: list[Exercise], needle: str) -> Exercise | None:
    exact = [exercise for exercise in exercises if exercise.ident == needle]
    if exact:
        return exact[0]
    matches = [
        exercise
        for exercise in exercises
        if exercise.ident.endswith(f"/{needle}")
        or exercise.slug == needle
        or needle in exercise.ident
    ]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        print(red(f"ambiguous exercise: {needle}"))
        for exercise in matches:
            print(f"  {exercise.ident}")
    else:
        print(red(f"unknown exercise: {needle}"))
        suggestions = difflib.get_close_matches(needle, [e.ident for e in exercises], n=3, cutoff=0.35)
        if suggestions:
            print("Did you mean:\n  " + "\n  ".join(suggestions))
    return None


def resolve(exercises: list[Exercise], needle: str | None) -> Exercise | None:
    if needle is None:
        completed = load_progress()
        for exercise in exercises:
            if exercise.ident not in completed:
                return exercise
        return None
    return select(exercises, needle)


# --------------------------------------------------------------------------
# Running
# --------------------------------------------------------------------------


def normalise(text: str, stage: Path) -> str:
    """Make output comparable across machines and directories."""
    text = text.replace(str(stage), "<stage>")
    lines = [line.rstrip() for line in text.splitlines()]
    while lines and not lines[-1]:
        lines.pop()
    return "\n".join(lines)


def compare(actual_text: str, expected: str, mode: str, stage: Path) -> bool:
    actual = normalise(actual_text, stage)
    wanted = normalise(expected, stage)
    if mode == "exact":
        return actual == wanted
    if mode == "contains":
        return wanted in actual
    if mode == "not_contains":
        return wanted not in actual
    if mode == "regex":
        return re.search(wanted, actual, re.MULTILINE) is not None
    expected_lines = [line for line in wanted.splitlines() if line.strip()]
    actual_lines = actual.splitlines()
    if mode == "contains_lines":
        return all(line in actual_lines for line in expected_lines)
    if mode == "ordered_lines":
        remaining = iter(actual_lines)
        return all(any(line == want for line in remaining) for want in expected_lines)
    raise ValueError(f"unknown match mode: {mode}")


def show(label: str, text: str, expected: str | None = None,
         stage: Path | None = None) -> list[str]:
    normalisation_stage = stage or Path("/nonexistent")
    lines = [f"    {label}:"]
    body = text if text.strip() else "(empty)"
    for line in normalise(body, normalisation_stage).splitlines() or [""]:
        lines.append(f"      | {line}")
    if expected is not None:
        lines.append(f"    expected ({label}):")
        for line in normalise(expected, normalisation_stage).splitlines() or [""]:
            lines.append(f"      | {line}")
    return lines


def stage_tree(source: Path, destination: Path) -> None:
    shutil.rmtree(destination, ignore_errors=True)
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(source, destination)
    age_staged_files(destination)


def age_staged_files(stage: Path) -> None:
    """Give the staged files a deterministic timestamp far in the past.

    make decides what to rebuild by comparing modification times, and the
    exercises lean on that: a file the exercise ships is "already there", so
    anything a recipe writes during the contract must count as newer.  Left to
    the wall clock, that only holds when the filesystem separates the two
    writes by at least one tick of its timestamp granularity -- on a runner
    whose granularity is a whole second, a recipe can write a target in the
    same tick as the staged prerequisite it was built from, and make then
    reports "up to date" where the contract expects a rebuild.

    Dated to a fixed instant well before now, with one second between files in
    sorted order, the comparison no longer depends on how fast the driver
    happened to write.  Sorting also fixes the relative order among staged
    files themselves, which copytree would otherwise leave to readdir.
    """
    for offset, path in enumerate(sorted(stage.rglob("*"))):
        if path.is_file():
            stamp = STAGE_EPOCH + offset
            os.utime(path, (stamp, stamp))


def run_step(step: Step, stage: Path, output: list[str] | None = None) -> list[str]:
    """Run one step; return a list of human-readable problems (empty = passed)."""
    command = step.args[0]
    if "/" in command:
        candidate = Path(command)
        if not candidate.is_absolute():
            candidate = stage / candidate
        executable = str(candidate) if candidate.is_file() and os.access(candidate, os.X_OK) else None
    else:
        executable = shutil.which(command)
    if executable is None:
        return [f"    {command}: command not found or not executable"]

    environment = os.environ.copy()
    environment.update(BASE_ENV)
    environment.update(step.env)

    try:
        result = subprocess.run(
            step.args,
            cwd=stage,
            env=environment,
            text=True,
            errors="replace",
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=STEP_TIMEOUT,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return [f"    timed out after {STEP_TIMEOUT:g}s: {' '.join(step.args)}"]
    except OSError as error:
        return [f"    could not run {' '.join(step.args)}: {error}"]

    problems: list[str] = []
    if result.returncode != step.exit_code:
        problems.append(
            f"    exit code: got {result.returncode}, want {step.exit_code}"
        )
    stdout_mismatch = step.stdout is not None and not compare(
        result.stdout, step.stdout, step.stdout_mode, stage
    )
    if stdout_mismatch:
        problems.append(f"    stdout did not match ({step.stdout_mode})")
        problems.extend(show("stdout", result.stdout, step.stdout, stage))
    stderr_mismatch = step.stderr is not None and not compare(
        result.stderr, step.stderr, step.stderr_mode, stage
    )
    if stderr_mismatch:
        problems.append(f"    stderr did not match ({step.stderr_mode})")
        problems.extend(show("stderr", result.stderr, step.stderr, stage))

    for name, content in step.files.items():
        target = stage / name
        if not target.exists():
            problems.append(f"    missing file: {name}")
            continue
        if not target.is_file():
            problems.append(f"    expected a file, found a directory: {name}")
            continue
        actual = target.read_text(encoding="utf-8", errors="replace")
        if not compare(actual, content, "exact", stage):
            problems.append(f"    file {name} has unexpected contents")
            problems.extend(show(f"{name}", actual, content, stage))

    for name in step.missing:
        if (stage / name).exists():
            problems.append(f"    file should not exist: {name}")

    # Unasserted stderr still contains the most useful diagnostic on failure.
    if problems:
        if result.stdout and not stdout_mismatch:
            problems.extend(show("stdout", result.stdout, stage=stage))
        if result.stderr and not stderr_mismatch:
            problems.extend(show("stderr", result.stderr, stage=stage))
        if "missing separator" in result.stderr:
            problems.append("    提示：检查命令行开头的缩进；recipe 需要真正的 Tab，而不是空格。")
    elif output is not None:
        if result.stdout:
            output.extend(show("stdout", result.stdout, stage=stage))
        if result.stderr:
            output.extend(show("stderr", result.stderr, stage=stage))

    return problems


def run_contract(exercise: Exercise, source: Path, verbose: bool = False) -> tuple[bool, list[str], Path]:
    parent = BUILD_DIR / exercise.topic / exercise.slug
    if not source.is_dir():
        return False, [f"    missing tree: {source.relative_to(ROOT)}"], parent
    parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix="run-", dir=parent))
    shutil.copytree(source, stage, dirs_exist_ok=True)
    age_staged_files(stage)

    report: list[str] = []
    for index, step in enumerate(exercise.steps, start=1):
        label = step.description or " ".join(step.args)
        output: list[str] = []
        problems = run_step(step, stage, output if verbose else None)
        if problems:
            report.append(f"    step {index}: {label}")
            report.extend(problems)
            report.append(f"    working directory kept at {stage.relative_to(ROOT)}")
            command = shlex.join(["env", *[f"{k}={v}" for k, v in {**BASE_ENV, **step.env}.items()], *step.args])
            report.append(f"    inspect: cd {shlex.quote(str(stage))}")
            report.append(f"    retry this step: {command}")
            report.append("    注意：这里保留的是失败后的状态。重新运行 makefiling 可从干净副本重放全部步骤。")
            return False, report, stage
        if verbose:
            report.append(f"    step {index}: ok  {label}")
            report.extend(output)
    if verbose:
        report.append(f"    working directory kept at {stage.relative_to(ROOT)}")
    return True, report, stage


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------


def print_exercise(exercise: Exercise, completed: set[str], verbose: bool = False) -> None:
    status = green("done") if exercise.ident in completed else yellow("todo")
    print(f"[{status}] {cyan(exercise.ident)}  {exercise.title}")
    if exercise.objective:
        print(f"       {exercise.objective}")
    if verbose and exercise.reference:
        print(f"       reference: {exercise.reference}")


def show_learning_task(exercise: Exercise) -> None:
    print(f"修改文件：{exercise.path.relative_to(ROOT)}/Makefile（以及题目要求的辅助文件）")
    if exercise.lesson:
        print(f"目标：{exercise.lesson['goal']}")
        print(f"先预测：{exercise.lesson['prediction']}")
    else:
        print(f"objective: {exercise.objective}")
    print(f"提示：./makefiling hint {exercise.ident}")


def show_success(exercise: Exercise, basic: bool = False) -> None:
    if exercise.lesson:
        print(f"理解检查：{exercise.lesson['explanation']}")
    print("下一题：./makefiling next" + (" --basic" if basic else ""))


def completed_message(basic: bool = False) -> None:
    if basic:
        print(green("基础路线已完成。请用 docs/first-project.md 的小项目检验能否独立运用。"))
    else:
        print(green("All exercises are complete. 用 ./makefiling run --all 复查你的解答。"))


def command_start(args: argparse.Namespace) -> int:
    args.basic = True
    args.topic = None
    args.exercise = None
    print("欢迎来到 makefiling。先完成 20 题基础路线，再按需要学习进阶专题。")
    print("学习方式：预测会发生什么 → 修改文件 → 观察结果 → 解释原因。")
    print("基础模型与路线：docs/basics.md；小项目：docs/first-project.md\n")
    return command_next(args)


def command_list(args: argparse.Namespace) -> int:
    exercises = filter_exercises(discover(), args.topic, args.basic)
    if not exercises:
        return 1
    completed = load_progress()
    current = None
    for exercise in exercises:
        if exercise.topic != current:
            current = exercise.topic
            print(f"\n{cyan(current)}")
        print_exercise(exercise, completed, verbose=args.verbose)
    done = sum(1 for exercise in exercises if exercise.ident in completed)
    print(f"\n{done}/{len(exercises)} completed")
    return 0


def command_next(args: argparse.Namespace) -> int:
    exercises = filter_exercises(discover(), args.topic, args.basic)
    if not exercises:
        return 1
    exercise = resolve(exercises, args.exercise)
    if exercise is None:
        if args.exercise is not None:
            return 1
        completed_message(args.basic)
        return 0
    print_exercise(exercise, load_progress(), verbose=True)
    show_learning_task(exercise)
    print(f"运行：./makefiling run {exercise.ident}" + (" --basic" if args.basic else ""))
    print(f"保存后自动检查：./makefiling watch {exercise.ident}" + (" --basic" if args.basic else ""))
    return 0


def command_run(args: argparse.Namespace) -> int:
    exercises = filter_exercises(discover(), args.topic, args.basic)
    if not exercises:
        return 1

    if args.all:
        targets = exercises
    else:
        exercise = resolve(exercises, args.exercise)
        if exercise is None:
            if args.exercise is not None:
                return 1
            completed_message(args.basic)
            return 0
        targets = [exercise]

    failures = 0
    for exercise in targets:
        print(f"\n{cyan('running')} {exercise.ident} - {exercise.title}")
        if not args.all:
            show_learning_task(exercise)
        passed, report, _stage = run_contract(exercise, exercise.path, args.verbose)
        record_result(exercise, passed)
        if passed:
            print(green("  passed"))
            if args.verbose:
                for line in report:
                    print(line)
            if not args.all:
                show_success(exercise, args.basic)
            continue
        failures += 1
        print(red("  failed"))
        for line in report:
            print(line)
        if not args.continue_on_error:
            break

    if failures:
        print(red(f"\n{failures} exercise(s) failed"))
        return 1
    print(green("\nall selected exercises passed"))
    return 0


def command_hint(args: argparse.Namespace) -> int:
    exercises = filter_exercises(discover(), basic=args.basic)
    if not exercises:
        return 1
    exercise = resolve(exercises, args.exercise)
    if exercise is None:
        if args.exercise is not None:
            return 1
        completed_message(args.basic)
        return 0
    print(f"{cyan(exercise.ident)} - {exercise.title}")
    print(f"objective: {exercise.objective}")
    if exercise.reference:
        print(f"reference: {exercise.reference}")
    if exercise.lesson:
        print(f"先预测：{exercise.lesson['prediction']}")
        for index, hint in enumerate(exercise.lesson['hints'][:args.level], 1):
            print(f"提示 {index}：{hint}")
        if args.level < 3:
            print(f"需要更具体的提示：./makefiling hint {exercise.ident} --level {args.level + 1}")
    else:
        print(f"hint: {exercise.hint}")
    if args.steps:
        print("\nchecks:")
        for index, step in enumerate(exercise.steps, start=1):
            print(f"  {index}. {step.description or ' '.join(step.args)}")
            print(dim(f"     $ {shlex.join(step.args)}"))
            print(f"     expected exit code: {step.exit_code}")
            if step.env:
                print(f"     environment: {shlex.join([f'{k}={v}' for k, v in step.env.items()])}")
            for label, content, mode in (("stdout", step.stdout, step.stdout_mode),
                                         ("stderr", step.stderr, step.stderr_mode)):
                if content is not None:
                    print(f"     {label} must match ({mode}):")
                    for line in content.strip("\n").splitlines() or ["(empty)"]:
                        print(dim(f"       | {line}"))
            for name, content in step.files.items():
                print(f"     file {name} must contain (normalized exact):")
                for line in content.strip("\n").splitlines() or ["(empty)"]:
                    print(dim(f"       | {line}"))
            for name in step.missing:
                print(f"     must not exist: {name}")
    return 0


def command_solution(args: argparse.Namespace) -> int:
    exercise = select(discover(), args.exercise)
    if exercise is None:
        return 1
    if not exercise.solution_root.is_dir():
        print(red(f"missing solution: {exercise.solution_root}"))
        return 1
    if args.apply:
        stage_tree(exercise.solution_root, exercise.path)
        record_result(exercise, False)
        print(green(f"applied solution to {exercise.path.relative_to(ROOT)}"))
        print(f"读懂改动后运行 ./makefiling run {exercise.ident} 验证；应用答案本身不计为通过。")
        return 0
    for path in sorted(exercise.solution_root.rglob("*")):
        if not path.is_file() or path.name == "checks.json":
            continue
        print(f"# ===== {path.relative_to(exercise.solution_root)} =====")
        print(path.read_text(encoding="utf-8"), end="")
    return 0


def command_reset(args: argparse.Namespace) -> int:
    exercise = select(discover(), args.exercise)
    if exercise is None:
        return 1
    if not exercise.template_root.is_dir():
        print(red(f"missing template: {exercise.template_root}"))
        return 1
    stage_tree(exercise.template_root, exercise.path)
    record_result(exercise, False)
    print(green(f"reset {exercise.ident}"))
    return 0


def command_verify(args: argparse.Namespace) -> int:
    exercises = filter_exercises(discover(SOLUTIONS_DIR), args.topic)
    if not exercises:
        return 1
    if args.exercise:
        one = select(exercises, args.exercise)
        if one is None:
            return 1
        exercises = [one]

    failures = 0
    for exercise in exercises:
        passed, report, _stage = run_contract(
            exercise, exercise.solution_root, args.verbose
        )
        if passed:
            print(f"{green('ok')}   {exercise.ident}")
            continue
        failures += 1
        print(f"{red('FAIL')} {exercise.ident}")
        for line in report:
            print(line)

    if failures:
        print(red(f"\n{failures} solution(s) failed"))
        return 1
    print(green(f"\nall {len(exercises)} solutions passed"))
    return 0


def command_selftest(args: argparse.Namespace) -> int:
    """Check immutable templates and solutions, independent of learner edits."""
    exercises = filter_exercises(discover(SOLUTIONS_DIR), args.topic)
    if not exercises:
        return 1
    failures = 0
    for exercise in exercises:
        solved, solution_report, _stage = run_contract(
            exercise, exercise.solution_root, True
        )
        if not solved:
            failures += 1
            print(f"{red('FAIL')} solution {exercise.ident}")
            for line in solution_report:
                print(line)
            continue

        if not (exercise.template_root / "checks.json").is_file():
            failures += 1
            print(f"{red('FAIL')} missing template {exercise.ident}")
            continue
        passed, _report, stage = run_contract(exercise, exercise.template_root)
        if passed:
            failures += 1
            print(f"{red('FAIL')} template {exercise.ident} already passes")
            continue
        shutil.rmtree(stage)  # This failure is expected; no diagnostic tree needed.
        print(f"{green('ok')}   {exercise.ident}")

    if failures:
        print(red(f"\n{failures} selftest failure(s)"))
        return 1
    print(green(f"\nall {len(exercises)} exercises behave correctly"))
    return 0


def command_doctor(args: argparse.Namespace) -> int:
    print(f"python:   {platform.python_version()}")
    print(f"platform: {platform.platform()}")
    print(f"root:     {ROOT}")
    for tool in ("make", "cc", "gcc", "clang", "rm", "touch", "cat"):
        path = shutil.which(tool)
        print(f"{tool + ':':9s} {path or 'not found'}")
    if shutil.which("make"):
        version = subprocess.run(
            ["make", "--version"], text=True, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, check=False,
        ).stdout.splitlines()
        print(f"make:     {version[0] if version else 'unknown'}")
    exercises = discover()
    print(f"exercises: {len(exercises)} in {len({e.topic for e in exercises})} topics")
    return 0


def command_watch(args: argparse.Namespace) -> int:
    exercises = filter_exercises(discover(), args.topic, args.basic)
    if not exercises:
        return 1
    exercise = resolve(exercises, args.exercise)
    if exercise is None:
        if args.exercise is not None:
            return 1
        completed_message(args.basic)
        return 0
    print(f"watching {exercise.ident}; press Ctrl-C to stop")
    show_learning_task(exercise)
    last = None
    while True:
        fingerprint = exercise.fingerprint()
        if fingerprint != last:
            last = fingerprint
            refreshed = load_exercise(exercise.path)
            if refreshed is None:
                record_result(exercise, False)
                time.sleep(0.5)
                continue
            exercise = refreshed
            print(f"\n{cyan('running')} {exercise.ident}")
            passed, report, _stage = run_contract(exercise, exercise.path, True)
            record_result(exercise, passed)
            print(green("passed") if passed else red("failed"))
            for line in report:
                print(line)
            if passed:
                show_success(exercise, args.basic)
        time.sleep(0.5)


def command_clean(args: argparse.Namespace) -> int:
    if BUILD_DIR.exists():
        shutil.rmtree(BUILD_DIR)
        print(green(f"removed {BUILD_DIR.relative_to(ROOT)}"))
    else:
        print("nothing to clean")
    return 0


def command_generate(args: argparse.Namespace) -> int:
    sys.path.insert(0, str(ROOT / "tools"))
    import generate_exercises

    argv: list[str] = []
    if args.topic:
        argv += ["--topic", args.topic]
    return int(generate_exercises.main(argv))


