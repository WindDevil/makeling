# Entry point
# --------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="makefiling",
        description="Run and verify the makefiling Makefile exercises.",
    )
    subparsers = parser.add_subparsers(dest="command")

    start = subparsers.add_parser("start", help="start the guided beginner path")
    start.set_defaults(func=command_start)

    listing = subparsers.add_parser("list", help="list every exercise")
    listing.add_argument("--topic", help="only show topics starting with this")
    listing.add_argument("--verbose", action="store_true")
    listing.add_argument("--basic", action="store_true", help="follow the 20-lesson beginner path")
    listing.set_defaults(func=command_list)

    nxt = subparsers.add_parser("next", help="show the next unsolved exercise")
    nxt.add_argument("exercise", nargs="?")
    nxt.add_argument("--topic")
    nxt.add_argument("--basic", action="store_true")
    nxt.set_defaults(func=command_next)

    run = subparsers.add_parser("run", help="run an exercise against its checks")
    selection = run.add_mutually_exclusive_group()
    selection.add_argument("exercise", nargs="?")
    selection.add_argument("--all", action="store_true", help="run every exercise")
    run.add_argument("--topic", help="restrict to one topic")
    run.add_argument("--basic", action="store_true")
    run.add_argument("--continue", dest="continue_on_error", action="store_true",
                     help="keep going after a failure")
    run.add_argument("--verbose", action="store_true")
    run.set_defaults(func=command_run)

    hint = subparsers.add_parser("hint", help="show the objective and a hint")
    hint.add_argument("exercise", nargs="?")
    hint.add_argument("--basic", action="store_true")
    hint.add_argument("--level", type=int, choices=(1, 2, 3), default=1,
                      help="progressively reveal beginner hints")
    hint.add_argument("--steps", action="store_true", help="also show the checks")
    hint.set_defaults(func=command_hint)

    solution = subparsers.add_parser("solution", help="show or apply the solution")
    solution.add_argument("exercise")
    solution.add_argument("--apply", action="store_true",
                          help="copy the solution over the exercise")
    solution.set_defaults(func=command_solution)

    reset = subparsers.add_parser("reset", help="restore the original exercise")
    reset.add_argument("exercise")
    reset.set_defaults(func=command_reset)

    verify = subparsers.add_parser("verify", help="run the solutions")
    verify.add_argument("exercise", nargs="?")
    verify.add_argument("--topic")
    verify.add_argument("--verbose", action="store_true")
    verify.set_defaults(func=command_verify)

    selftest = subparsers.add_parser(
        "selftest", help="check original templates fail and solutions pass"
    )
    selftest.add_argument("--topic")
    selftest.set_defaults(func=command_selftest)

    doctor = subparsers.add_parser("doctor", help="show toolchain information")
    doctor.set_defaults(func=command_doctor)

    watch = subparsers.add_parser("watch", help="re-run an exercise on change")
    watch.add_argument("exercise", nargs="?")
    watch.add_argument("--topic")
    watch.add_argument("--basic", action="store_true")
    watch.set_defaults(func=command_watch)

    clean = subparsers.add_parser("clean", help="remove staged working copies")
    clean.set_defaults(func=command_clean)

    generate = subparsers.add_parser("generate", help="regenerate from the specs")
    generate.add_argument("--topic")
    generate.set_defaults(func=command_generate)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "func"):
        args = parser.parse_args(["list"])
    try:
        return int(args.func(args))
    except KeyboardInterrupt:
        print("\ninterrupted")
        return 130
    except BrokenPipeError:
        # Commands such as `makefiling list | head` should end quietly.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
