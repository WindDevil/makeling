      "stderr": null,
      "stderr_mode": "contains",
      "env": {},
      "files": {},
      "missing": []
    },
    {
      "args": [
        "make",
        "stamp"
      ],
      "description": "there is no file called stamp, so it runs again",
      "exit_code": 0,
