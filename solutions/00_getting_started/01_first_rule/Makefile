# makefiling exercise: 00_getting_started/01_first_rule
# title: The simplest Makefile
# objective: Write a rule that prints Hello, World when make runs.
# reference: Running the Examples
# hint: A rule is a target line followed by its recipe. Every recipe line must begin with a real TAB character; four spaces will be rejected with "missing separator".

hello:
	echo "Hello, World"
