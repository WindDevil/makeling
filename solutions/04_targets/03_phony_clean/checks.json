{
  "exercise": "04_targets/03_phony_clean",
  "title": "A file that shadows clean",
  "objective": "Declare clean phony so that the stray file called clean does not make make skip the recipe.",
  "reference": "Make clean",
  "hint": "make compares the target name with the filesystem. .PHONY: clean tells make that clean is a name to run, never a file to check.",
  "steps": [
    {
      "args": [
        "make",
        "some_file"
      ],
      "description": "build the file that clean is supposed to remove",
      "exit_code": 0,
      "stdout": "echo \"content\" > some_file",
      "stdout_mode": "ordered_lines",
      "stderr": null,
      "stderr_mode": "contains",
      "env": {},
      "files": {},
      "missing": []
    },
    {
      "args": [
        "make",
        "-n",
        "clean"
      ],
      "description": "the dry run shows the recipe and removes nothing",
      "exit_code": 0,
      "stdout": "rm -f some_file",
      "stdout_mode": "ordered_lines",
      "stderr": null,
      "stderr_mode": "contains",
      "env": {},
      "files": {
        "some_file": "content\n"
      },
      "missing": []
    },
    {
      "args": [
        "make",
        "clean"
      ],
      "description": "clean really runs, even though a file named clean exists",
      "exit_code": 0,
      "stdout": "rm -f some_file",
      "stdout_mode": "ordered_lines",
      "stderr": null,
      "stderr_mode": "contains",
      "env": {},
      "files": {},
      "missing": [
        "some_file"
      ]
    }
  ]
}
